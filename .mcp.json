{
  "mcpServers": {
    "cachelayer": {
      "type": "http",
      "url": "https://api.cachelayer.org/mcp/http",
      "headers": {
        "Authorization": "Bearer ${env:CACHELAYER_KEY}"
      }
    },
    "cachelayer-agent": {
      "type": "stdio",
      "command": "${PLUGIN_ROOT}/cachelayer_tools/run_mcp.sh"
    }
  }
}
