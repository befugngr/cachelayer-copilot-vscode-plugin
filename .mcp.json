{
  "mcpServers": {
    "cachelayer": {
      "type": "http",
      "url": "https://api.cachelayer.org/mcp/http",
      "headers": {
        "Authorization": "Bearer ${env:CACHELAYER_KEY}"
      }
    },
    "cachelayer-agent": {
      "type": "stdio",
      "command": "./agent/run.sh",
      "env": {
        "CACHELAYER_WORKSPACE_ROOT": "${workspaceFolder}"
      }
    }
  }
}
