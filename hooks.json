{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "matcher": "Read|Grep|Glob|WebSearch|WebFetch|mcp__.+__(read|grep|glob|search|fetch).*",
        "command": "bash scripts/pre_tool_use.sh",
        "windows": "powershell -File scripts\\pre_tool_use.ps1",
        "timeout": 3
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "matcher": "Read|Grep|Glob|WebSearch|WebFetch|mcp__.+__(read|grep|glob|search|fetch).*",
        "command": "bash scripts/post_tool_use.sh",
        "timeout": 3,
        "windows": "powershell -File scripts\\post_tool_use.ps1"
      },
      {
        "type": "command",
        "matcher": "Edit|Write|ApplyPatch|MultiEdit|NotebookEdit|create|edit|apply_patch|create_file|edit_file|write_file|patch_file|str_replace_editor|replace_string_in_file|insert_edit_into_file|multi_replace_string_in_file",
        "command": "bash -c 'for d in \"$CLAUDE_PLUGIN_ROOT\" \"$PLUGIN_ROOT\" .; do [ -n \"$d\" ] && [ -f \"$d/cachelayer_tools/run_verify_hook.sh\" ] && exec bash \"$d/cachelayer_tools/run_verify_hook.sh\"; done; printf \"{}\\n\"'",
        "timeout": 15,
        "windows": "cachelayer_tools\\run_verify_hook.cmd"
      }
    ]
  }
}
