{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "bash scripts/pre_tool_use.sh",
        "windows": "powershell -File scripts\\pre_tool_use.ps1",
        "timeout": 3
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "bash scripts/post_tool_use.sh",
        "timeout": 3
      },
      {
        "type": "command",
        "matcher": "Edit|Write|create|edit|apply_patch|str_replace_editor|create_file|replace_string_in_file|insert_edit_into_file|multi_replace_string_in_file",
        "command": "bash -c 'for d in \"$CLAUDE_PLUGIN_ROOT\" \"$PLUGIN_ROOT\" .; do [ -n \"$d\" ] && [ -f \"$d/agent/run_critic.sh\" ] && exec bash \"$d/agent/run_critic.sh\"; done; printf \"{}\\n\"'",
        "timeout": 15
      }
    ]
  }
}
