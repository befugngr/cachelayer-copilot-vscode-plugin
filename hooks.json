{
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "matcher": "Read|Grep|Glob|WebSearch|WebFetch|read_file|grep_search|file_search|list_dir|semantic_search|web_search|fetch_webpage|read_project_structure|get_errors|get_changed_files|get_terminal_output|search_workspace_symbols|view_image|mcp__.+__(read|grep|glob|search|fetch).*",
        "command": "bash \"${PLUGIN_ROOT}/scripts/post_tool_use.sh\"",
        "timeout": 1,
        "windows": "powershell -NoProfile -File \"${PLUGIN_ROOT}\\scripts\\post_tool_use.ps1\""
      }
    ]
  }
}
